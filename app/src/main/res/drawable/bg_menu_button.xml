<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado enfocado: Brillo intenso y borde definido -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#FFD1DC"
                android:angle="270" />
            <corners android:radius="16dp" />
            <stroke
                android:width="4dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Estado normal: Semi-transparente para ver el fondo satinado -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CCFFE8D6" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#80E8B4A0" />
        </shape>
    </item>
</selector>