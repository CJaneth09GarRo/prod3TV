<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFF3E0"
    android:padding="20dp">

    <!-- TITULO -->

    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🍕 PIZZERÍA VELOZ 🍕"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#5D4037" />

    <!-- INFORMACION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="Puntos: 0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6D4C41" />

        <TextView
            android:id="@+id/tvPizzas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="Pizzas: 0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6D4C41" />

    </LinearLayout>

    <!-- RECETA -->

    <LinearLayout
        android:id="@+id/recipePanel"
        android:layout_width="500dp"
        android:layout_height="150dp"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="15dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨‍🍳 Pedido del cliente:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037" />

        <TextView
            android:id="@+id/tvRecipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tomate → Queso → Peperoni"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ingrediente 1 de 3"
            android:textSize="16sp"
            android:textColor="#795548" />

    </LinearLayout>

    <!-- TABLERO -->

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="320dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="15dp">

        <!-- ARRIBA -->

        <Button
            android:id="@+id/btnTomate"
            android:layout_width="180dp"
            android:layout_height="75dp"
            android:background="@drawable/bg_game_button"
            android:focusable="true"
            android:text="🍅\nTomate ↑"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <!-- CENTRO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChampinon"
                android:layout_width="170dp"
                android:layout_height="75dp"
                android:background="@drawable/bg_game_button"
                android:focusable="true"
                android:text="🍄\nChampiñón ←"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPizza"
                android:layout_width="170dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="🍕\nMASA"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

            <Button
                android:id="@+id/btnPeperoni"
                android:layout_width="170dp"
                android:layout_height="75dp"
                android:background="@drawable/bg_game_button"
                android:focusable="true"
                android:text="🌶️\nPeperoni →"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ABAJO -->

        <Button
            android:id="@+id/btnQueso"
            android:layout_width="180dp"
            android:layout_height="75dp"
            android:background="@drawable/bg_game_button"
            android:focusable="true"
            android:text="🧀\nQueso ↓"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- FEEDBACK -->

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="¡Prepara la pizza!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#5D4037" />

</LinearLayout>