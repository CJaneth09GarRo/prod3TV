<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0"
    android:padding="24dp">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFE4D1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi TV CJanGR"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart TV OS"
                android:textSize="16sp"
                android:textColor="#795548" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00:00"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#4E342E" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11/08/2026"
                android:textSize="16sp"
                android:textColor="#795548" />

            <TextView
                android:id="@+id/tvClima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ 22°C - Soleado"
                android:textSize="16sp"
                android:textColor="#795548" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================= TITULO ================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="¿Qué quieres hacer?"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#5D4037" />


    <!-- ================= MENU ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnJuego"
                android:layout_width="310dp"
                android:layout_height="150dp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_menu_button"
                android:focusable="true"
                android:clickable="true"
                android:text="🍕\nJuego Pizzería"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

            <Button
                android:id="@+id/btnMusica"
                android:layout_width="310dp"
                android:layout_height="150dp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_menu_button"
                android:focusable="true"
                android:clickable="true"
                android:text="🎵\nMúsica"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="310dp"
                android:layout_height="150dp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_menu_button"
                android:focusable="true"
                android:clickable="true"
                android:text="▶️\nVideo"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

            <Button
                android:id="@+id/btnProtector"
                android:layout_width="310dp"
                android:layout_height="150dp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_menu_button"
                android:focusable="true"
                android:clickable="true"
                android:text="🌙\nProtector"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================= FOOTER ================= -->

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="© 2026 - Desarrollado por Mi Nombre | Smart TV OS Project"
        android:textSize="14sp"
        android:textColor="#795548" />

</LinearLayout>