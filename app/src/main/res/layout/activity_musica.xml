<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Fondo con gradiente simulado por un color sólido o imagen -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_music_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="40dp"
        android:gravity="center">

        <!-- Lado Izquierdo: Arte del álbum -->
        <androidx.cardview.widget.CardView
            android:layout_width="350dp"
            android:layout_height="350dp"
            android:layout_marginEnd="50dp"
            android:elevation="20dp"
            android:backgroundTint="#1A1A1A">

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music"
                android:contentDescription="Album Art" />
        </androidx.cardview.widget.CardView>

        <!-- Lado Derecho: Controles e Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la Canción"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artista Desconocido"
                android:textColor="#B3B3B3"
                android:textSize="24sp"
                android:layout_marginTop="8dp" />

            <!-- Barra de progreso visual (decorativa) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="32dp" />

            <View
                android:layout_width="150dp"
                android:layout_height="4dp"
                android:background="#E94560"
                android:layout_marginTop="-4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="⏮"
                    android:textSize="24sp"
                    android:focusable="true"
                    android:background="@drawable/bg_round_button" />

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginHorizontal="20dp"
                    android:text="▶"
                    android:textSize="30sp"
                    android:focusable="true"
                    android:background="@drawable/bg_round_button_large" />

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="⏭"
                    android:textSize="24sp"
                    android:focusable="true"
                    android:background="@drawable/bg_round_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Listo"
                android:textColor="#E94560"
                android:textSize="18sp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>